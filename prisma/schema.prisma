// Schema Prisma du projet FibreConnect.
//
// CONTRAINTE SQLITE : SQLite ne supporte pas les `enum` Prisma.
// Les champs `role`, `statutCompte`, `statut`, `priorite`, `typePanne` et `zone`
// sont donc des `String`. Les valeurs autorisees sont definies dans
// `lib/constants.ts` (`as const` + types TypeScript derives) et validees avec
// zod a chaque ecriture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Compte de connexion, commun aux trois roles.
model Utilisateur {
  id           String   @id @default(cuid())
  email        String   @unique
  motDePasse   String // hache avec bcrypt (10 rounds), jamais en clair
  role         String // CLIENT | TECHNICIEN | SUPERVISEUR -- voir lib/constants.ts
  nom          String
  prenom       String
  telephone    String
  // ACTIF | EN_ATTENTE | DESACTIVE. Seul ACTIF autorise la connexion.
  // EN_ATTENTE : technicien inscrit par lui-meme, pas encore valide.
  statutCompte String   @default("ACTIF")
  creeLe       DateTime @default(now())

  // Reinitialisation du mot de passe.
  //
  // Le jeton n'est PAS stocke : seule son empreinte SHA-256 l'est. Une base
  // derobee, ou une sauvegarde egaree, ne doit pas livrer des liens de
  // reinitialisation utilisables -- c'est le meme raisonnement que pour le
  // mot de passe lui-meme.
  //
  // @unique parce que le compte se retrouve par cette empreinte. SQLite
  // considere les NULL comme distincts, donc les innombrables comptes sans
  // demande en cours ne se genent pas entre eux.
  jetonReset       String?   @unique
  jetonResetExpire DateTime?

  // Profil metier : au plus un des deux selon le role.
  client     Client?
  technicien Technicien?

  // Interventions assignees par cet utilisateur quand il est SUPERVISEUR.
  interventionsSupervisees Intervention[] @relation("Superviseur")

  @@index([role])
}

/// Operateur avec lequel un abonne a signe son contrat fibre.
/// FibreConnect depanne les abonnes de ces reseaux, mais ses techniciens sont
/// ses propres employes : aucun technicien n'est rattache a un operateur.
model Operateur {
  id      String  @id @default(cuid())
  nom     String  @unique
  logoUrl String?

  clients Client[]
}

/// Profil d'un abonne.
/// `operateurId` : son fournisseur d'acces, pour l'information seulement.
/// `zone` : ce qui determine quel technicien voit sa panne (voir Technicien).
model Client {
  id            String @id @default(cuid())
  utilisateurId String @unique
  operateurId   String
  adresse       String
  ville         String
  zone          String // voir ZONES dans lib/constants.ts
  numContrat    String @unique
  latitude      Float?
  longitude     Float?

  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  operateur     Operateur      @relation(fields: [operateurId], references: [id])
  interventions Intervention[]

  @@index([operateurId])
  @@index([zone])
}

/// Profil d'un technicien FibreConnect, employe de la societe.
///
/// REGLE CENTRALE : `zone` est le secteur geographique qu'il couvre. Un
/// technicien ne voit dans son tableau de bord que les pannes NOUVELLE dont
/// l'abonne est dans la meme zone que lui, quel que soit son operateur.
model Technicien {
  id            String  @id @default(cuid())
  utilisateurId String  @unique
  // Attribue par le superviseur. Null tant que le compte n'est pas valide :
  // un technicien qui s'inscrit lui-meme n'a pas encore de matricule.
  matricule     String? @unique
  specialite    String
  zone          String // voir ZONES dans lib/constants.ts
  disponible    Boolean @default(true)
  photoUrl      String?

  // Ni salaire ni commission ici. La remuneration des salaries est une affaire
  // interne a la societe, traitee par sa comptabilite. Cette application suit
  // les interventions et l'argent que l'ABONNE doit ; elle s'arrete la ou
  // commence la paie. Les especes encaissees restent, elles : ce n'est pas du
  // salaire, c'est de l'argent de la societe qui dort dans une poche.

  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  historiques   Historique[]
  encaissements Paiement[] // especes encaissees pour le compte de la societe
  versements    Versement[]

  @@index([zone])
}

/// Une panne declaree par un client, puis prise en charge par un technicien.
model Intervention {
  id            String    @id @default(cuid())
  clientId      String
  technicienId  String? // null tant que personne n'a accepte
  superviseurId String? // renseigne si l'assignation est manuelle
  typePanne     String // voir TYPES_PANNE dans lib/constants.ts
  description   String
  statut        String    @default("NOUVELLE") // NOUVELLE|ASSIGNEE|EN_COURS|TERMINEE|ANNULEE
  priorite      String    @default("NORMALE") // BASSE|NORMALE|HAUTE|URGENTE
  dateCreation  DateTime  @default(now())
  dateDebut     DateTime?
  dateFin       DateTime?
  rapport       String? // obligatoire (>= 10 caracteres) au passage en TERMINEE
  noteClient    Int? // 1 a 5, une seule fois, uniquement si TERMINEE

  // Photos jointes, stockees dans /public/televersements.
  photoPanne   String? // prise par le client a la declaration
  photoRapport String? // prise par le technicien a la cloture

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  technicien  Technicien?  @relation(fields: [technicienId], references: [id])
  superviseur Utilisateur? @relation("Superviseur", fields: [superviseurId], references: [id])
  historiques Historique[]
  facture     Facture?

  @@index([statut])
  @@index([clientId])
  @@index([technicienId])
}

/// Facture emise a la cloture d'une intervention, dans la meme transaction.
///
/// Une intervention terminee a toujours exactement une facture (relation 1-1),
/// ce qui interdit l'etat « travaux faits, rien a payer » qu'aucune des deux
/// parties ne saurait interpreter.
///
/// Tous les montants sont des ENTIERS EN MILLIMES (voir lib/monnaie.ts).
model Facture {
  id             String @id @default(cuid())
  interventionId String @unique
  // Reference lisible et citable au telephone : FC-2026-0007.
  numero         String @unique

  // Decomposition figee a l'emission. Le taux de TVA et le droit de timbre
  // sont recopies ici et non lus dans lib/constants.ts au moment de
  // l'affichage : ils changent par decision budgetaire, et une facture de l'an
  // dernier doit continuer a se relire avec les taux de l'an dernier. Une
  // facture ancienne dont le total se recalculerait au taux du jour ne
  // correspondrait plus a ce que l'abonne a paye.
  montantHT    Int // somme des lignes, toutes hors taxes
  tauxTva      Float
  montantTva   Int
  timbreFiscal Int
  montantTotal Int // toutes taxes comprises : c'est ce que l'abonne doit

  statut       String    @default("A_PAYER") // A_PAYER | PAYEE | ANNULEE
  dateEmission DateTime  @default(now())
  datePaiement DateTime? // renseignee quand le solde atteint le total

  // Derniere rectification par le superviseur : correction des lignes ou
  // annulation. Le motif est obligatoire cote applicatif — une facture qui
  // change de montant sans que personne sache pourquoi est indefendable
  // devant l'abonne comme devant le technicien qui l'a etablie.
  motifRectification String?
  dateRectification  DateTime?
  rectifieePar       String? // id du superviseur

  intervention Intervention   @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  lignes       LigneFacture[]
  paiements    Paiement[]

  @@index([statut])
}

/// Detail d'une facture : le deplacement, puis chaque piece remplacee.
/// Garder les lignes plutot qu'un seul total permet a l'abonne de voir ce
/// qu'il paie, et au superviseur de contester une piece sans refaire le calcul.
model LigneFacture {
  id          String @id @default(cuid())
  factureId   String
  designation String
  montant     Int // en millimes, HORS TAXES

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
}

/// Un reglement, total ou partiel, d'une facture.
///
/// `technicienId` n'est renseigne que pour les especes : c'est lui qui cree la
/// dette du technicien envers la societe, que le versement vient eteindre.
model Paiement {
  id        String @id @default(cuid())
  factureId String
  montant   Int // en millimes
  moyen     String // ESPECES | CARTE | VIREMENT | D17
  statut    String @default("EN_ATTENTE") // EN_ATTENTE | CONFIRME | ECHOUE

  // Reference du mouvement : numero de recu especes, ou identifiant renvoye
  // par la passerelle. Unique pour qu'un rejeu ne compte pas deux fois.
  reference String @unique

  // Ce qui identifie le moyen sur le recu : « Visa ••••4242 », « D17 ••••1234 ».
  // Compose par le serveur a partir de la marque et des quatre derniers
  // chiffres — le numero complet n'arrive jamais jusqu'ici et ne doit jamais y
  // arriver : seul un prestataire de paiement agree a le droit de le conserver.
  detail String?

  // Technicien ayant encaisse les especes. Null pour tout paiement en ligne.
  technicienId String?
  // Versement dans lequel ces especes ont ete reversees. Null tant que le
  // technicien garde l'argent.
  versementId  String?

  dateCreation     DateTime  @default(now())
  dateConfirmation DateTime?

  facture    Facture     @relation(fields: [factureId], references: [id], onDelete: Cascade)
  technicien Technicien? @relation(fields: [technicienId], references: [id])
  versement  Versement?  @relation(fields: [versementId], references: [id])

  @@index([factureId])
  @@index([technicienId])
  @@index([statut])
}

/// Remise des especes collectees par un technicien a la societe.
///
/// Deux temps volontairement distincts : le technicien declare avoir remis
/// l'argent (EN_ATTENTE), le superviseur confirme l'avoir recu (CONFIRME).
/// Confondre les deux reviendrait a croire le technicien sur parole sur un
/// mouvement d'especes, ce qu'aucune comptabilite n'accepte.
model Versement {
  id           String  @id @default(cuid())
  technicienId String
  montant      Int // en millimes, somme des paiements rattaches
  statut       String  @default("EN_ATTENTE") // EN_ATTENTE | CONFIRME
  commentaire  String?

  dateCreation     DateTime  @default(now())
  dateConfirmation DateTime?
  // Superviseur ayant accuse reception.
  confirmePar      String?

  technicien Technicien @relation(fields: [technicienId], references: [id], onDelete: Cascade)
  paiements  Paiement[]

  @@index([technicienId])
  @@index([statut])
}

/// Journal des transitions de statut. Ecrit uniquement par
/// `changerStatut()` dans lib/interventions.ts, dans une transaction.
model Historique {
  id             String   @id @default(cuid())
  interventionId String
  technicienId   String? // null si l'action vient du client ou du superviseur
  action         String
  ancienStatut   String? // null pour la creation de l'intervention
  nouveauStatut  String
  dateAction     DateTime @default(now())
  commentaire    String?

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  technicien   Technicien?  @relation(fields: [technicienId], references: [id])

  @@index([interventionId])
}
