# Copier ce fichier en `.env` puis remplir les valeurs.
# Le vrai `.env` n'est jamais versionne (voir .gitignore).

# Base SQLite locale, relative au dossier prisma/
DATABASE_URL="file:./dev.db"

# URL publique de l'application
NEXTAUTH_URL="http://localhost:3000"

# Cle de signature des sessions. En generer une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Affiche le panneau des comptes de demonstration sur /login (false en production)
NEXT_PUBLIC_MODE_DEMO="true"
