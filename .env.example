# Copier ce fichier en `.env` puis remplir les valeurs.
# Le vrai `.env` n'est jamais versionne (voir .gitignore).

# Base SQLite locale, relative au dossier prisma/
DATABASE_URL="file:./dev.db"

# URL publique de l'application
NEXTAUTH_URL="http://localhost:3000"

# Cle de signature des sessions. En generer une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Affiche le panneau des comptes de demonstration sur /login (false en production)
NEXT_PUBLIC_MODE_DEMO="true"

# --- Courriels ---------------------------------------------------------------
# Transport : « fichier » (defaut), « smtp » ou « silencieux ».
#   fichier    : depose un .eml dans courrier/, n'envoie rien. Ouvrable dans
#                n'importe quel logiciel de messagerie. C'est le mode de la
#                machine de demonstration.
#   smtp       : envoie reellement. Selectionne tout seul des que SMTP_HOTE
#                est renseigne.
#   silencieux : compose et jette. Utilise par les tests.
COURRIER_TRANSPORT="fichier"

# Adresse d'expedition. Par defaut celle de lib/societe.ts.
COURRIER_EXPEDITEUR=""

# Serveur d'envoi. Port 465 = TLS direct, 587 = STARTTLS.
# Laisser SMTP_HOTE vide tant qu'aucun compte n'existe : le mode fichier prend
# le relais et l'application continue de fonctionner.
SMTP_HOTE=""
SMTP_PORT="587"
SMTP_UTILISATEUR=""
SMTP_MOTDEPASSE=""
